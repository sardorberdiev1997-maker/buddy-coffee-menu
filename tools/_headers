# HTTP-заголовки для Cloudflare Pages (копируется в dist/_headers при сборке)
# frame-ancestors разрешает web.telegram.org — там сайт открывается как Telegram Mini App.
# X-Frame-Options не ставим: он не умеет «только этот сайт», а CSP frame-ancestors его заменяет.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://telegram.org {{SCRIPT_HASHES}}; style-src 'self' {{STYLE_HASHES}}; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://docs.google.com https://*.googleusercontent.com https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'self' https://web.telegram.org; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Скрипты и стили с хешем в ссылке, шрифты — не меняются
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Фото: при замене файла давать ему новое имя — старое имя кэшируется надолго
/img/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300

/sw.js
  Cache-Control: no-cache

/order
  Cache-Control: no-cache
  Referrer-Policy: no-referrer

/manifest.webmanifest
  Cache-Control: public, max-age=86400
